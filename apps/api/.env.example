NODE_ENV=development
PORT=3000
LOG_LEVEL=info
ALLOWED_ORIGINS=http://localhost:5173
# Production: the public HTTPS domain customers can open. This is used for
# quotation links sent by email or WhatsApp, e.g. https://crm.example.com.
PUBLIC_APP_URL=https://crm.yourcompany.com
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=server-only-service-role-key
SUPABASE_JWT_ISSUER=https://your-project.supabase.co/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated
# Customer quotation email (use an app password for Gmail/Google Workspace).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=quotes@yourcompany.com
SMTP_PASS=your-smtp-app-password
MAIL_FROM=quotes@yourcompany.com
# Optional HTTPS logo used in the email header.
COMPANY_LOGO_URL=https://crm.yourcompany.com/logo.png
